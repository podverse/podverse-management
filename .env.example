#####
##### podverse-management
##### .env.example
#####
##### Copy this file to create your local .env file
#####

#####
##### API Configuration
#####
NEXT_PUBLIC_API_PROTOCOL=http
NEXT_PUBLIC_API_HOST=localhost
NEXT_PUBLIC_API_PORT=1999

NEXT_PUBLIC_API_PREFIX=/api
NEXT_PUBLIC_API_VERSION=/v2

#####
##### Brand Configuration
#####
NEXT_PUBLIC_BRAND_NAME="Podverse Management"

#####
##### Locale / i18n Configuration
#####
# Supported locales (blank defaults to "all-available")
NEXT_PUBLIC_FEATURES_SUPPORTED_LOCALES=
# Default locale (blank defaults to "en")
NEXT_PUBLIC_FEATURES_DEFAULT_LOCALE=
